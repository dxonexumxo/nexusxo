'use client'

import { useState, useRef, useEffect } from 'react'
import { useRouter } from 'next/navigation'
import Papa from 'papaparse'
import { supabase } from '@/utils/supabase'

type Phase = 'upload' | 'mapping' | 'preview' | 'uploading' | 'complete'

type StandardField = 'sku' | 'product_name' | 'category' | 'description' | 'price' | 'stock_quantity' | null

type ColumnMapping = {
  csvColumn: string
  mappedField: StandardField
  includeInAttributes: boolean
}

type UploadStats = {
  filename: string
  size: number
  rowCount: number
}

const STANDARD_FIELDS: { value: StandardField; label: string; required: boolean }[] = [
  { value: 'sku', label: 'SKU (Required)', required: true },
  { value: 'product_name', label: 'Product Name (Required)', required: true },
  { value: 'category', label: 'Category', required: false },
  { value: 'description', label: 'Description', required: false },
  { value: 'price', label: 'Price', required: false },
  { value: 'stock_quantity', label: 'Stock Quantity', required: false },
  { value: null, label: '-- Ignore Column --', required: false },
]

const AUTO_MATCH_RULES: Record<string, StandardField> = {
  // SKU mappings
  'sku': 'sku',
  'product_id': 'sku',
  'item_code': 'sku',
  'product_code': 'sku',
  'item_id': 'sku',
  // Product name mappings
  'name': 'product_name',
  'product_name': 'product_name',
  'title': 'product_name',
  'item_name': 'product_name',
  'product_title': 'product_name',
  'product': 'product_name',
  // Category mappings
  'category': 'category',
  'product_category': 'category',
  'type': 'category',
  'product_type': 'category',
  'group': 'category',
  // Description mappings
  'description': 'description',
  'desc': 'description',
  'details': 'description',
  'product_description': 'description',
  'product_details': 'description',
  // Price mappings
  'price': 'price',
  'cost': 'price',
  'retail_price': 'price',
  'unit_price': 'price',
  'selling_price': 'price',
  // Stock mappings
  'stock': 'stock_quantity',
  'stock_quantity': 'stock_quantity',
  'quantity': 'stock_quantity',
  'qty': 'stock_quantity',
  'inventory': 'stock_quantity',
  'available': 'stock_quantity',
}

function autoMatchColumn(columnName: string): StandardField {
  const normalized = columnName.toLowerCase().trim().replace(/[_\s-]/g, '_')
  return AUTO_MATCH_RULES[normalized] || null
}

export default function ManufacturerUploadPage() {
  const router = useRouter()
  const fileInputRef = useRef<HTMLInputElement>(null)
  const [phase, setPhase] = useState<Phase>('upload')
  const [userId, setUserId] = useState<string | null>(null)
  const [uploadStats, setUploadStats] = useState<UploadStats | null>(null)
  const [csvData, setCsvData] = useState<any[]>([])
  const [csvHeaders, setCsvHeaders] = useState<string[]>([])
  const [columnMappings, setColumnMappings] = useState<ColumnMapping[]>([])
  const [uploadProgress, setUploadProgress] = useState({ current: 0, total: 0 })
  const [uploadResults, setUploadResults] = useState({ success: 0, errors: [] as string[] })
  const [isDragging, setIsDragging] = useState(false)
  const [error, setError] = useState<string | null>(null)

  useEffect(() => {
    const checkAuth = async () => {
      try {
        // Get authenticated user
        const { data: { user }, error: authError } = await supabase.auth.getUser()
        
        if (authError || !user) {
          console.error('Authentication error:', authError)
          router.push('/manufacturer/login')
          return
        }

        // Verify user is a manufacturer
        const { data: manufacturer, error: mfgError } = await supabase
          .from('manufacturers')
          .select('id, company_name')
          .eq('id', user.id)
          .single()

        if (mfgError || !manufacturer) {
          console.error('Not a manufacturer:', mfgError)
          alert('Access denied. This page is for manufacturers only.')
          router.push('/manufacturer/login')
          return
        }

        console.log('✅ Authenticated as manufacturer:', manufacturer.company_name)
        setUserId(user.id)
      } catch (error) {
        console.error('Error checking authentication:', error)
        router.push('/manufacturer/login')
      }
    }
    
    checkAuth()
  }, [router])

  const handleFileSelect = async (file: File) => {
    if (!file.name.endsWith('.csv')) {
      setError('Please upload a CSV file only')
      return
    }

    setError(null)
    setUploadStats({
      filename: file.name,
      size: file.size,
      rowCount: 0,
    })

    Papa.parse(file, {
      header: true,
      skipEmptyLines: true,
      complete: (results) => {
        if (results.errors.length > 0 && results.data.length === 0) {
          setError('Failed to parse CSV file. Please check the file format.')
          return
        }

        if (results.data.length === 0) {
          setError('CSV file is empty. Please upload a file with data.')
          return
        }

        const headers = Object.keys(results.data[0] as object)
        const data = results.data as any[]

        if (headers.length === 0) {
          setError('No columns found in CSV file.')
          return
        }

        setCsvHeaders(headers)
        setCsvData(data)
        setUploadStats(prev => prev ? { ...prev, rowCount: data.length } : null)

        // Auto-create mappings with smart matching
        const mappings: ColumnMapping[] = headers.map(header => ({
          csvColumn: header,
          mappedField: autoMatchColumn(header),
          includeInAttributes: false,
        }))

        setColumnMappings(mappings)
        setPhase('mapping')
        
        console.log('📄 CSV parsed successfully:', {
          rows: data.length,
          columns: headers.length,
          headers: headers,
          autoMapped: mappings.filter(m => m.mappedField).length
        })
      },
      error: (error) => {
        setError(`Error parsing CSV: ${error.message}`)
      },
    })
  }

  const handleDragOver = (e: React.DragEvent) => {
    e.preventDefault()
    setIsDragging(true)
  }

  const handleDragLeave = (e: React.DragEvent) => {
    e.preventDefault()
    setIsDragging(false)
  }

  const handleDrop = (e: React.DragEvent) => {
    e.preventDefault()
    setIsDragging(false)

    const file = e.dataTransfer.files[0]
    if (file) {
      handleFileSelect(file)
    }
  }

  const handleFileInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (file) {
      handleFileSelect(file)
    }
  }

  const updateMapping = (csvColumn: string, mappedField: StandardField) => {
    setColumnMappings(prev =>
      prev.map(mapping =>
        mapping.csvColumn === csvColumn
          ? { ...mapping, mappedField, includeInAttributes: mappedField === null ? mapping.includeInAttributes : false }
          : mapping
      )
    )
  }

  const toggleIncludeInAttributes = (csvColumn: string) => {
    setColumnMappings(prev =>
      prev.map(mapping =>
        mapping.csvColumn === csvColumn
          ? { ...mapping, includeInAttributes: !mapping.includeInAttributes }
          : mapping
      )
    )
  }

  const validateMappings = (): string | null => {
    const skuMapped = columnMappings.some(m => m.mappedField === 'sku')
    const productNameMapped = columnMappings.some(m => m.mappedField === 'product_name')

    if (!skuMapped) return 'SKU field must be mapped'
    if (!productNameMapped) return 'Product Name field must be mapped'

    // Check for duplicate SKUs in file
    const skuColumn = columnMappings.find(m => m.mappedField === 'sku')?.csvColumn
    if (skuColumn) {
      const skus = csvData
        .map(row => row[skuColumn])
        .filter(sku => sku !== undefined && sku !== null && sku !== '')
      
      const uniqueSkus = new Set(skus)
      if (skus.length !== uniqueSkus.size) {
        return 'Duplicate SKUs found in the file. Please ensure each product has a unique SKU.'
      }

      // Check for empty SKUs
      if (skus.length < csvData.length) {
        return 'Some rows have empty SKU values. All products must have a SKU.'
      }
    }

    // Check for empty product names
    const productNameColumn = columnMappings.find(m => m.mappedField === 'product_name')?.csvColumn
    if (productNameColumn) {
      const emptyNames = csvData.filter(row => 
        !row[productNameColumn] || row[productNameColumn].trim() === ''
      )
      if (emptyNames.length > 0) {
        return 'Some rows have empty Product Name values. All products must have a name.'
      }
    }

    return null
  }

  const handlePreview = () => {
    const validationError = validateMappings()
    if (validationError) {
      setError(validationError)
      return
    }

    setError(null)
    setPhase('preview')
  }

  const handleUpload = async () => {
    if (!userId) {
      setError('User not authenticated. Please log in again.')
      router.push('/manufacturer/login')
      return
    }

    const validationError = validateMappings()
    if (validationError) {
      setError(validationError)
      setPhase('mapping')
      return
    }

    setPhase('uploading')
    setUploadProgress({ current: 0, total: csvData.length })
    setError(null)

    const errors: string[] = []
    let successCount = 0

    console.log('🚀 Starting upload for', csvData.length, 'products')

    for (let i = 0; i < csvData.length; i++) {
      const row = csvData[i]
      setUploadProgress({ current: i + 1, total: csvData.length })

      try {
        // Extract standard fields
        const standardFields: any = {
          manufacturer_id: userId, // ✅ Critical: Set manufacturer_id
        }
        const attributesJson: any = {}
        let hasError = false

        columnMappings.forEach(mapping => {
          const value = row[mapping.csvColumn]

          if (mapping.mappedField) {
            // Map to standard field
            if (mapping.mappedField === 'price' && value) {
              const cleanValue = String(value).replace(/[^0-9.-]/g, '')
              const numValue = parseFloat(cleanValue)
              if (isNaN(numValue)) {
                errors.push(`Row ${i + 2}: Invalid price value "${value}"`)
                hasError = true
                return
              }
              standardFields[mapping.mappedField] = numValue
            } else if (mapping.mappedField === 'stock_quantity' && value) {
              const cleanValue = String(value).replace(/[^0-9]/g, '')
              const intValue = parseInt(cleanValue, 10)
              if (isNaN(intValue)) {
                errors.push(`Row ${i + 2}: Invalid stock quantity value "${value}"`)
                hasError = true
                return
              }
              standardFields[mapping.mappedField] = intValue
            } else if (value !== undefined && value !== null && value !== '') {
              // Store as string, trim whitespace
              standardFields[mapping.mappedField] = String(value).trim()
            } else if (mapping.mappedField === 'sku' || mapping.mappedField === 'product_name') {
              // Required fields must have value
              errors.push(`Row ${i + 2}: Missing required field ${mapping.mappedField}`)
              hasError = true
              return
            }
          } else if (mapping.includeInAttributes && value !== undefined && value !== null && value !== '') {
            // Include in attributes JSON
            attributesJson[mapping.csvColumn] = String(value).trim()
          }
        })

        if (hasError) {
          continue // Skip this row
        }

        // Add attributes_json if there are custom attributes
        if (Object.keys(attributesJson).length > 0) {
          standardFields.attributes_json = attributesJson
        }

        console.log(`📦 Uploading product ${i + 1}:`, {
          sku: standardFields.sku,
          manufacturer_id: standardFields.manufacturer_id
        })

        // Insert into database
        const { error: insertError } = await supabase
          .from('product_data')
          .insert(standardFields)

        if (insertError) {
          console.error(`❌ Row ${i + 2} error:`, insertError)
          errors.push(`Row ${i + 2}: ${insertError.message}`)
        } else {
          successCount++
        }
      } catch (err: any) {
        console.error(`❌ Row ${i + 2} exception:`, err)
        errors.push(`Row ${i + 2}: ${err.message || 'Unknown error'}`)
      }
    }

    console.log('✅ Upload complete:', {
      success: successCount,
      errors: errors.length,
      total: csvData.length
    })

    setUploadResults({ success: successCount, errors })
    setPhase('complete')
  }

  const getMappedRowsPreview = () => {
    return csvData.slice(0, 5).map(row => {
      const mappedRow: any = {}
      const attributes: any = {}

      columnMappings.forEach(mapping => {
        const value = row[mapping.csvColumn]
        if (mapping.mappedField) {
          mappedRow[mapping.mappedField] = value
        } else if (mapping.includeInAttributes && value !== undefined && value !== null && value !== '') {
          attributes[mapping.csvColumn] = value
        }
      })

      return { mappedRow, attributes }
    })
  }

  const formatFileSize = (bytes: number) => {
    if (bytes < 1024) return bytes + ' B'
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(2) + ' KB'
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB'
  }

  const requiredFieldsMapped = () => {
    const skuMapped = columnMappings.some(m => m.mappedField === 'sku')
    const productNameMapped = columnMappings.some(m => m.mappedField === 'product_name')
    return skuMapped && productNameMapped
  }

  const getMappingStatusCounts = () => {
    const mapped = columnMappings.filter(m => m.mappedField !== null).length
    const inJson = columnMappings.filter(m => m.includeInAttributes).length
    const ignored = columnMappings.filter(m => m.mappedField === null && !m.includeInAttributes).length
    return { mapped, inJson, ignored, total: columnMappings.length }
  }

  if (!userId) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-50 to-gray-100">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mx-auto mb-4"></div>
          <div className="text-gray-600">Verifying authentication...</div>
        </div>
      </div>
    )
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8">
      <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="bg-white rounded-xl shadow-lg p-8">
          <div className="mb-8">
            <h1 className="text-3xl font-extrabold text-gray-900">Upload Product Catalog</h1>
            <p className="mt-2 text-sm text-gray-600">
              Import your products via CSV with intelligent column mapping
            </p>
          </div>

          {/* Phase Indicator */}
          <div className="mb-8 flex items-center justify-center">
            <div className="flex items-center space-x-4">
              {[
                { key: 'upload', label: 'Upload' },
                { key: 'mapping', label: 'Map' },
                { key: 'preview', label: 'Preview' },
                { key: 'uploading', label: 'Upload' },
                { key: 'complete', label: 'Done' }
              ].map((step, index) => {
                const phases = ['upload', 'mapping', 'preview', 'uploading', 'complete']
                const currentIndex = phases.indexOf(phase)
                const isActive = phase === step.key
                const isComplete = currentIndex > index

                return (
                  <div key={step.key} className="flex items-center">
                    <div className="flex flex-col items-center">
                      <div
                        className={`w-10 h-10 rounded-full flex items-center justify-center font-semibold transition-colors ${
                          isActive
                            ? 'bg-indigo-600 text-white ring-4 ring-indigo-100'
                            : isComplete
                            ? 'bg-green-500 text-white'
                            : 'bg-gray-200 text-gray-600'
                        }`}
                      >
                        {isComplete ? (
                          <svg className="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd" />
                          </svg>
                        ) : (
                          index + 1
                        )}
                      </div>
                      <span className={`mt-1 text-xs ${isActive ? 'text-indigo-600 font-semibold' : 'text-gray-500'}`}>
                        {step.label}
                      </span>
                    </div>
                    {index < 4 && (
                      <div
                        className={`w-16 h-1 mx-2 transition-colors ${
                          isComplete ? 'bg-green-500' : 'bg-gray-200'
                        }`}
                      />
                    )}
                  </div>
                )
              })}
            </div>
          </div>

          {error && (
            <div className="mb-6 rounded-md bg-red-50 p-4 border border-red-200">
              <div className="flex">
                <div className="flex-shrink-0">
                  <svg className="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path
                      fillRule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                      clipRule="evenodd"
                    />
                  </svg>
                </div>
                <div className="ml-3">
                  <p className="text-sm font-medium text-red-800">{error}</p>
                </div>
                <div className="ml-auto pl-3">
                  <button
                    onClick={() => setError(null)}
                    className="text-red-400 hover:text-red-600"
                  >
                    <svg className="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                      <path fillRule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clipRule="evenodd" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* PHASE 1: FILE UPLOAD */}
          {phase === 'upload' && (
            <div className="space-y-6">
              <div
                className={`border-2 border-dashed rounded-lg p-12 text-center transition-all ${
                  isDragging 
                    ? 'border-indigo-500 bg-indigo-50 scale-105' 
                    : 'border-gray-300 hover:border-gray-400 hover:bg-gray-50'
                }`}
                onDragOver={handleDragOver}
                onDragLeave={handleDragLeave}
                onDrop={handleDrop}
              >
                <svg
                  className="mx-auto h-16 w-16 text-gray-400"
                  stroke="currentColor"
                  fill="none"
                  viewBox="0 0 48 48"
                >
                  <path
                    d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02"
                    strokeWidth={2}
                    strokeLinecap="round"
                    strokeLinejoin="round"
                  />
                </svg>
                <div className="mt-6">
                  <label htmlFor="file-upload" className="cursor-pointer">
                    <span className="mt-2 block text-lg font-medium text-gray-900">
                      Drag and drop your CSV file here, or{' '}
                      <span className="text-indigo-600 hover:text-indigo-500 underline">browse</span>
                    </span>
                    <span className="mt-2 block text-sm text-gray-500">
                      CSV files only • Maximum file size: 10MB
                    </span>
                  </label>
                  <input
                    ref={fileInputRef}
                    id="file-upload"
                    name="file-upload"
                    type="file"
                    accept=".csv"
                    className="sr-only"
                    onChange={handleFileInputChange}
                  />
                </div>
              </div>

              <div className="bg-blue-50 rounded-lg p-4 border border-blue-200">
                <div className="flex">
                  <svg className="h-5 w-5 text-blue-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fillRule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clipRule="evenodd" />
                  </svg>
                  <div className="ml-3 text-sm text-blue-700">
                    <p className="font-medium">CSV Format Requirements:</p>
                    <ul className="mt-2 list-disc list-inside space-y-1">
                      <li>First row must contain column headers</li>
                      <li>Required: SKU and Product Name columns</li>
                      <li>Optional: Category, Description, Price, Stock Quantity</li>
                      <li>All other columns will be stored as custom attributes</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* PHASE 2: COLUMN MAPPING */}
          {phase === 'mapping' && uploadStats && (
            <div className="space-y-6">
              <div className="bg-gradient-to-r from-indigo-50 to-blue-50 rounded-lg p-4 border border-indigo-200">
                <h3 className="text-lg font-semibold text-gray-900 mb-3 flex items-center">
                  <svg className="h-5 w-5 text-indigo-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fillRule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clipRule="evenodd" />
                  </svg>
                  File Information
                </h3>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                  <div className="bg-white rounded p-3">
                    <span className="text-gray-600 block mb-1">Filename</span>
                    <span className="font-semibold text-gray-900 truncate block">{uploadStats.filename}</span>
                  </div>
                  <div className="bg-white rounded p-3">
                    <span className="text-gray-600 block mb-1">Size</span>
                    <span className="font-semibold text-gray-900">{formatFileSize(uploadStats.size)}</span>
                  </div>
                  <div className="bg-white rounded p-3">
                    <span className="text-gray-600 block mb-1">Rows</span>
                    <span className="font-semibold text-gray-900">{uploadStats.rowCount}</span>
                  </div>
                  <div className="bg-white rounded p-3">
                    <span className="text-gray-600 block mb-1">Columns</span>
                    <span className="font-semibold text-gray-900">{csvHeaders.length}</span>
                  </div>
                </div>
              </div>

              {(() => {
                const stats = getMappingStatusCounts()
                return (
                  <div className="flex items-center justify-between bg-gray-50 rounded-lg p-3 text-sm">
                    <div className="flex items-center space-x-4">
                      <span className="text-gray-600">Mapping Status:</span>
                      <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        {stats.mapped} Mapped
                      </span>
                      <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        {stats.inJson} In JSON
                      </span>
                      <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                        {stats.ignored} Ignored
                      </span>
                    </div>
                  </div>
                )
              })()}

              <div>
                <h3 className="text-lg font-semibold text-gray-900 mb-4">Map CSV Columns to Database Fields</h3>
                <div className="space-y-3">
                  {columnMappings.map((mapping, index) => {
                    const fieldInfo = STANDARD_FIELDS.find(f => f.value === mapping.mappedField)
                    const isRequired = fieldInfo?.required || false
                    const isMapped = mapping.mappedField !== null
                    const isUnmapped = !isMapped

                    return (
                      <div 
                        key={mapping.csvColumn} 
                        className={`border rounded-lg p-4 transition-all ${
                          isRequired && isMapped 
                            ? 'border-green-200 bg-green-50' 
                            : mapping.includeInAttributes 
                            ? 'border-blue-200 bg-blue-50'
                            : 'border-gray-200 bg-white hover:border-gray-300'
                        }`}
                      >
                        <div className="flex items-center justify-between">
                          <div className="flex-1">
                            <div className="flex items-center space-x-3">
                              <span className="font-mono text-sm font-medium text-gray-900 bg-gray-100 px-3 py-1 rounded w-64 truncate">
                                {mapping.csvColumn}
                              </span>
                              <svg className="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fillRule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clipRule="evenodd" />
                              </svg>
                              <select
                                value={mapping.mappedField || ''}
                                onChange={(e) => updateMapping(mapping.csvColumn, e.target.value as StandardField)}
                                className="flex-1 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm"
                              >
                                {STANDARD_FIELDS.map(field => (
                                  <option key={field.value || 'null'} value={field.value || ''}>
                                    {field.label}
                                  </option>
                                ))}
                              </select>
                              {isRequired && isMapped && (
                                <svg className="h-6 w-6 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                  <path
                                    fillRule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                    clipRule="evenodd"
                                  />
                                </svg>
                              )}
                              {!isRequired && isMapped && (
                                <svg className="h-6 w-6 text-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                  <path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clipRule="evenodd" />
                                </svg>
                              )}
                            </div>
                            {isUnmapped && (
                              <div className="mt-3 ml-3 flex items-center">
                                <input
                                  type="checkbox"
                                  id={`include-${index}`}
                                  checked={mapping.includeInAttributes}
                                  onChange={() => toggleIncludeInAttributes(mapping.csvColumn)}
                                  className="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
                                />
                                <label htmlFor={`include-${index}`} className="ml-2 text-sm text-gray-700 font-medium">
                                  Include in attributes_json (custom attribute)
                                </label>
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                    )
                  })}
                </div>

                {!requiredFieldsMapped() && (
                  <div className="mt-6 rounded-md bg-red-50 p-4 border border-red-200">
                    <div className="flex">
                      <div className="flex-shrink-0">
                        <svg className="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                          <path
                            fillRule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                            clipRule="evenodd"
                          />
                        </svg>
                      </div>
                      <div className="ml-3">
                        <h3 className="text-sm font-medium text-red-800">Required Fields Missing</h3>
                        <p className="mt-1 text-sm text-red-700">
                          You must map both <strong>SKU</strong> and <strong>Product Name</strong> fields before proceeding.
                        </p>
                      </div>
                    </div>
                  </div>
                )}

                <div className="mt-6 flex justify-between items-center">
                  <button
                    onClick={() => {
                      setPhase('upload')
                      setError(null)
                      setCsvData([])
                      setCsvHeaders([])
                      setColumnMappings([])
                      setUploadStats(null)
                      if (fileInputRef.current) {
                        fileInputRef.current.value = ''
                      }
                    }}
                    className="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
                  >
                    ← Choose Different File
                  </button>
                  <button
                    onClick={handlePreview}
                    disabled={!requiredFieldsMapped()}
                    className="px-6 py-2 bg-indigo-600 text-white rounded-md text-sm font-medium hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-sm"
                  >
                    Preview Data →
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* PHASE 3: DATA PREVIEW */}
          {phase === 'preview' && (
            <div className="space-y-6">
              <div className="bg-blue-50 rounded-lg p-4 border border-blue-200">
                <div className="flex items-center">
                  <svg className="h-5 w-5 text-blue-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fillRule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clipRule="evenodd" />
                  </svg>
                  <p className="text-sm font-medium text-blue-800">
                    Preview shows first 5 rows. {csvData.length} total products will be uploaded.
                  </p>
                </div>
              </div>

              <div>
                <h3 className="text-lg font-semibold text-gray-900 mb-4">Standard Fields Preview</h3>
                <div className="overflow-x-auto border rounded-lg shadow-sm">
                  <table className="min-w-full divide-y divide-gray-200">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                          Row
                        </th>
                        {columnMappings
                          .filter(m => m.mappedField !== null)
                          .map(mapping => (
                            <th
                              key={mapping.mappedField}
                              className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                            >
                              {mapping.mappedField}
                              {STANDARD_FIELDS.find(f => f.value === mapping.mappedField)?.required && (
                                <span className="text-red-500 ml-1">*</span>
                              )}
                            </th>
                          ))}
                      </tr>
                    </thead>
                    <tbody className="bg-white divide-y divide-gray-200">
                      {getMappedRowsPreview().map((row, index) => (
                        <tr key={index} className="hover:bg-gray-50">
                          <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-500">
                            {index + 1}
                          </td>
                          {columnMappings
                            .filter(m => m.mappedField !== null)
                            .map(mapping => (
                              <td key={mapping.mappedField} className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                {row.mappedRow[mapping.mappedField!] || <span className="text-gray-400">-</span>}
                              </td>
                            ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>

              {columnMappings.some(m => m.includeInAttributes) && (
                <div>
                  <h3 className="text-lg font-semibold text-gray-900 mb-4">
                    Custom Attributes JSON Preview
                    <span className="ml-2 text-sm font-normal text-gray-500">(First Row)</span>
                  </h3>
                  <div className="bg-gray-900 rounded-lg p-4 overflow-x-auto">
                    <pre className="text-sm text-green-400 font-mono">
                      {JSON.stringify(getMappedRowsPreview()[0]?.attributes || {}, null, 2)}
                    </pre>
                  </div>
                  <p className="mt-2 text-xs text-gray-500">
                    These custom attributes will be searchable and available for retailers to download.
                  </p>
                </div>
              )}

              <div className="flex justify-between items-center pt-4">
                <button
                  onClick={() => {
                    setPhase('mapping')
                    setError(null)
                  }}
                  className="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
                >
                  ← Back to Mapping
                </button>
                <button
                  onClick={handleUpload}
                  className="px-6 py-2 bg-green-600 text-white rounded-md text-sm font-medium hover:bg-green-700 transition-colors shadow-sm flex items-center"
                >
                  <svg className="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clipRule="evenodd" />
                  </svg>
                  Confirm and Upload {csvData.length} Products
                </button>
              </div>
            </div>
          )}

          {/* PHASE 4: UPLOADING */}
          {phase === 'uploading' && (
            <div className="space-y-6 text-center py-12">
              <div className="flex justify-center">
                <svg className="animate-spin h-16 w-16 text-indigo-600" fill="none" viewBox="0 0 24 24">
                  <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                  <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </div>
              <div>
                <div className="text-2xl font-bold text-gray-900 mb-2">
                  Uploading Products...
                </div>
                <div className="text-lg text-gray-600">
                  {uploadProgress.current} of {uploadProgress.total} uploaded
                </div>
                <div className="text-sm text-gray-500 mt-1">
                  {Math.round((uploadProgress.current / uploadProgress.total) * 100)}% complete
                </div>
              </div>
              <div className="max-w-xl mx-auto">
                <div className="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
                  <div
                    className="bg-gradient-to-r from-indigo-500 to-blue-600 h-3 rounded-full transition-all duration-300 ease-out"
                    style={{ width: `${(uploadProgress.current / uploadProgress.total) * 100}%` }}
                  />
                </div>
              </div>
              <p className="text-sm text-gray-500 italic">
                Please don't close this window...
              </p>
            </div>
          )}

          {/* PHASE 5: COMPLETE */}
          {phase === 'complete' && (
            <div className="space-y-6">
              {uploadResults.success > 0 && (
                <div className="rounded-md bg-green-50 p-6 border border-green-200">
                  <div className="flex items-center">
                    <div className="flex-shrink-0">
                      <svg className="h-8 w-8 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                        <path
                          fillRule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                          clipRule="evenodd"
                        />
                      </svg>
                    </div>
                    <div className="ml-4">
                      <h3 className="text-lg font-medium text-green-800">
                        Upload Successful!
                      </h3>
                      <p className="mt-1 text-sm text-green-700">
                        Successfully uploaded <strong>{uploadResults.success}</strong> products to your catalog.
                      </p>
                    </div>
                  </div>
                </div>
              )}

              {uploadResults.errors.length > 0 && (
                <div className="rounded-md bg-yellow-50 p-6 border border-yellow-200">
                  <div className="flex">
                    <div className="flex-shrink-0">
                      <svg className="h-6 w-6 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                        <path
                          fillRule="evenodd"
                          d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                          clipRule="evenodd"
                        />
                      </svg>
                    </div>
                    <div className="ml-3 flex-1">
                      <h3 className="text-sm font-medium text-yellow-800 mb-2">
                        {uploadResults.errors.length} error(s) occurred during upload:
                      </h3>
                      <div className="bg-white rounded border border-yellow-200 p-3 max-h-60 overflow-y-auto">
                        <ul className="list-disc list-inside text-sm text-yellow-700 space-y-1">
                          {uploadResults.errors.map((error, index) => (
                            <li key={index} className="font-mono text-xs">{error}</li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              <div className="bg-gray-50 rounded-lg p-6 border border-gray-200">
                <h3 className="text-lg font-semibold text-gray-900 mb-4">Upload Summary</h3>
                <div className="grid grid-cols-3 gap-4">
                  <div className="text-center p-4 bg-white rounded-lg border">
                    <div className="text-3xl font-bold text-green-600">{uploadResults.success}</div>
                    <div className="text-sm text-gray-600 mt-1">Successful</div>
                  </div>
                  <div className="text-center p-4 bg-white rounded-lg border">
                    <div className="text-3xl font-bold text-red-600">{uploadResults.errors.length}</div>
                    <div className="text-sm text-gray-600 mt-1">Failed</div>
                  </div>
                  <div className="text-center p-4 bg-white rounded-lg border">
                    <div className="text-3xl font-bold text-blue-600">{csvData.length}</div>
                    <div className="text-sm text-gray-600 mt-1">Total Rows</div>
                  </div>
                </div>
              </div>

              <div className="flex justify-between items-center pt-4">
                <button
                  onClick={() => {
                    setPhase('upload')
                    setError(null)
                    setCsvData([])
                    setCsvHeaders([])
                    setColumnMappings([])
                    setUploadStats(null)
                    setUploadResults({ success: 0, errors: [] })
                    if (fileInputRef.current) {
                      fileInputRef.current.value = ''
                    }
                  }}
                  className="px-6 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
                >
                  Upload Another File
                </button>
                <button
                  onClick={() => router.push('/manufacturer/dashboard')}
                  className="px-6 py-2 bg-indigo-600 text-white rounded-md text-sm font-medium hover:bg-indigo-700 transition-colors shadow-sm"
                >
                  Go to Dashboard →
                </button>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  )
}
